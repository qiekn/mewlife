#!/usr/bin/env jai

#run {
    gallery_path := ".";
    readme_path  := "README.md";


    files: [..] string;

    visit_files(gallery_path, false, *files, (info: *File_Visit_Info, files: *[..] string) {
            if info.is_directory return;

            _, _, extension, name := path_decomp(info.full_name);

            if extension != "jpg" return;

            array_add(files, copy_string(name));
        }
    );

    quick_sort(files, compare_strings);

    builder: String_Builder;

    append(*builder, "# Gallery\n\n");
    append(*builder, "<sub>Generated by [update_gallery](./update_gallery) (using jai as scripting language)</sub>\n\n");

    for files {
        filename := it;

        append(*builder, tprint("### %\n\n", filename));
        append(*builder, tprint("![%](%)\n\n", filename, filename));
    }

    ok := write_entire_file(readme_path, *builder);

    if !ok {
        print("Failed to write %\n", readme_path);
    } else {
        print("Updated % with % images.\n", readme_path, files.count);
    }

    set_build_options_dc(.{do_output=false});
}

#import "Basic";
#import "File";
#import "File_Utilities";
#import "String";
#import "Sort";
#import "Compiler";

// vim: set ft=jai
